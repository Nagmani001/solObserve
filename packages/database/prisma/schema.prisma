// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier])
  @@map("verification")
}

enum OrgMemberRole {
  owner
  admin
  editor
  viewer

  @@map("org_member_role")
}

enum SolanaCluster {
  mainnet
  devnet
  testnet
  localnet

  @@map("solana_cluster")
}

enum ProgramStatus {
  active
  paused
  archived

  @@map("program_status")
}

enum IdlSource {
  upload
  on_chain
  manual

  @@map("idl_source")
}

enum CommitmentPromotion {
  confirmed
  finalized

  @@map("commitment_promotion")
}

enum DashboardTemplateKind {
  generic_anchor
  dex
  lending
  nft
  escrow
  governance
  staking

  @@map("dashboard_template_kind")
}

// Control-plane tables migrated via sqlx (see crates/solobserve-storage/migrations). Do not prisma-migrate these.
model SolobserveUser {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  name       String
  imageUrl   String?   @map("image_url")
  authUserId String    @unique @map("auth_user_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orgMembers OrgMember[]
  idlsUploaded Idl[] @relation("IdlUploader")

  @@unique([email])
  @@map("users")
}

model Org {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String      @unique
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  projects  Project[]
  members   OrgMember[]
  apiKeys   ApiKey[]
  auditLogs AuditLog[]

  @@map("orgs")
}

model OrgMember {
  orgId  String          @map("org_id") @db.Uuid
  userId String          @map("user_id") @db.Uuid
  role   OrgMemberRole

  org  Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user SolobserveUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
  @@map("org_members")
}

model Project {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String      @map("org_id") @db.Uuid
  name      String
  slug      String
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  org      Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  programs SolanaProgram[]

  @@unique([orgId, slug])
  @@map("projects")
}

model SolanaProgram {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  programId   String           @map("program_id")
  cluster     SolanaCluster
  displayName String           @map("display_name")
  status      ProgramStatus    @default(active)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  idls    Idl[]
  ingestionConfig IngestionConfig?
  ingestionStates IngestionState[]
  ingestionErrors IngestionError[]
  trackedAccounts TrackedAccount[]
  dashboards Dashboard[]

  @@unique([projectId, programId, cluster])
  @@index([projectId])
  @@map("programs")
}

model Dashboard {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk      String   @map("program_id_fk") @db.Uuid
  name             String
  slug             String
  ownerUserId      String?  @map("owner_user_id") @db.Uuid
  isTemplateSeeded Boolean  @default(false) @map("is_template_seeded")
  shareToken       String?  @unique @map("share_token")
  shareRedactSigners Boolean @default(true) @map("share_redact_signers")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  program SolanaProgram  @relation(fields: [programIdFk], references: [id], onDelete: Cascade)
  panels  DashboardPanel[]

  @@unique([programIdFk, slug])
  @@map("dashboards")
}

model DashboardPanel {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboardIdFk String   @map("dashboard_id_fk") @db.Uuid
  position      Json     @db.JsonB
  title         String
  panelType     String   @map("panel_type")
  queryDsl      String   @map("query_dsl")
  options       Json     @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  dashboard Dashboard @relation(fields: [dashboardIdFk], references: [id], onDelete: Cascade)

  @@map("dashboard_panels")
}

model DashboardTemplate {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String                @unique
  kind       DashboardTemplateKind
  definition Json                  @db.JsonB
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("dashboard_templates")
}

model Idl {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk  String       @map("program_id_fk") @db.Uuid
  version      Int
  rawJson      Json         @map("raw_json") @db.JsonB
  parsedJson   Json         @map("parsed_json") @db.JsonB
  source       IdlSource    @default(upload)
  uploadedById String?      @map("uploaded_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  program    SolanaProgram @relation(fields: [programIdFk], references: [id], onDelete: Cascade)
  uploadedBy SolobserveUser? @relation("IdlUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([programIdFk, version])
  @@map("idls")
}

model ApiKey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  name         String
  prefix       String
  hashedSecret String    @map("hashed_secret")
  scopes       Json      @db.JsonB
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_keys")
}

model AuditLog {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String?    @map("org_id") @db.Uuid
  actorUserId String?    @map("actor_user_id") @db.Uuid
  action      String
  targetType  String     @map("target_type")
  targetId    String     @map("target_id")
  metadata    Json       @db.JsonB
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  org Org? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("audit_log")
}

model IngestionConfig {
  programIdFk          String              @id @map("program_id_fk") @db.Uuid
  cluster              SolanaCluster
  enabled              Boolean             @default(true)
  primaryEndpoint      String              @map("primary_endpoint")
  fallbackEndpoints    String[]            @default([]) @map("fallback_endpoints")
  commitmentPromotion  CommitmentPromotion @default(confirmed) @map("commitment_promotion")
  backfillWindowHours  Int                 @default(24) @map("backfill_window_hours")
  startedAt            DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  pausedAt             DateTime?           @map("paused_at") @db.Timestamptz(6)

  program SolanaProgram @relation(fields: [programIdFk], references: [id], onDelete: Cascade)

  @@map("ingestion_configs")
}

model IngestionState {
  programIdFk            String       @map("program_id_fk") @db.Uuid
  cluster                SolanaCluster
  lastProcessedSlot      BigInt       @default(0) @map("last_processed_slot")
  lastProcessedSignature String?      @map("last_processed_signature")
  lastSeenAt             DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  lagSlots               Int          @default(0) @map("lag_slots")

  program SolanaProgram @relation(fields: [programIdFk], references: [id], onDelete: Cascade)

  @@id([programIdFk, cluster])
  @@map("ingestion_state")
}

model IngestionError {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk String        @map("program_id_fk") @db.Uuid
  cluster     SolanaCluster
  kind        String
  message     String
  signature   String?
  slot        BigInt?
  occurredAt  DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  resolvedAt  DateTime?     @map("resolved_at") @db.Timestamptz(6)

  program SolanaProgram @relation(fields: [programIdFk], references: [id], onDelete: Cascade)

  @@index([programIdFk, occurredAt(sort: Desc)])
  @@map("ingestion_errors")
}

model TrackedAccount {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk String        @map("program_id_fk") @db.Uuid
  cluster     SolanaCluster
  account     String
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  program SolanaProgram @relation(fields: [programIdFk], references: [id], onDelete: Cascade)

  @@unique([programIdFk, cluster, account])
  @@map("tracked_accounts")
}
