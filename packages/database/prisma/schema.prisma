  appliedAt   DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  address Address @relation(fields: [addressIdFk], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagIdFk], references: [id], onDelete: Cascade)

  @@id([addressIdFk, tagIdFk])
  @@map("address_tags")
}

model TagProposal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  address     String
  tagIdFk     String   @map("tag_id_fk") @db.Uuid
  evidence    Json     @default("{}") @db.JsonB
  status      String   @default("pending")
