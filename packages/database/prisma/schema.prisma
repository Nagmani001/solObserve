enum TagScope {
  public_
  org
}

model Address {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  address      String   @unique
  firstSeenAt  DateTime? @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(6)
  solBalance   BigInt?   @map("sol_balance")
  metadata     Json      @default("{}") @db.JsonB

  tags AddressTag[]

  @@map("addresses")
}

model Tag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  scope       TagScope
  orgIdFk     String?  @map("org_id_fk") @db.Uuid
  color       String   @default("#888")
  description String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org      Org?         @relation(fields: [orgIdFk], references: [id], onDelete: Cascade)
  addresses AddressTag[]

  @@unique([scope, orgIdFk, name])
  @@map("tags")
}

model AddressTag {
  addressIdFk String   @map("address_id_fk") @db.Uuid
  tagIdFk     String   @map("tag_id_fk") @db.Uuid
