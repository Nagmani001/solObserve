// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier])
  @@map("verification")
}

enum OrgMemberRole {
  owner
  admin
  editor
  viewer

  @@map("org_member_role")
}

enum SolanaCluster {
  mainnet
  devnet
  testnet
  localnet

  @@map("solana_cluster")
}

enum ProgramStatus {
  active
  paused
  archived

  @@map("program_status")
}

enum IdlSource {
  upload
  on_chain
  manual

  @@map("idl_source")
}

enum CommitmentPromotion {
  confirmed
  finalized

  @@map("commitment_promotion")
}

enum DashboardTemplateKind {
  generic_anchor
  dex
  lending
  nft
  escrow
  governance
  staking

  @@map("dashboard_template_kind")
}

enum ErrorIssueStatus {
  open
  acknowledged
  resolved
  muted

  @@map("error_issue_status")
}

enum ErrorClassification {
  anchor_constraint
  anchor_custom
  runtime
  unknown

  @@map("error_classification")
}

enum AlertRuleKind {
  dsl
  template

  @@map("alert_rule_kind")
}

enum AlertSeverity {
  info
  warn
  critical

  @@map("alert_severity")
}

enum AlertStateStatus {
  ok
  pending
  firing
  stale

  @@map("alert_state_status")
}

enum AlertIncidentStatus {
  firing
  acknowledged
  resolved
  silenced

  @@map("alert_incident_status")
}

enum AlertIncidentEventKind {
  fired
  notified
  acked
  resolved
  silenced
  comment
  related_tx
  related_state

  @@map("alert_incident_event_kind")
}

enum AlertDeliveryStatus {
  pending
  sent
  failed

  @@map("alert_delivery_status")
}

enum ReplayRunStatus {
  queued
  running
  succeeded
  failed
  timed_out

  @@map("replay_run_status")
}

enum NotificationChannelKind {
  slack
  discord
  email
  webhook
  pagerduty
  telegram

  @@map("notification_channel_kind")
}

// Control-plane tables migrated via sqlx (see crates/solobserve-storage/migrations). Do not prisma-migrate these.
model SolobserveUser {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  name       String
  imageUrl   String?   @map("image_url")
  authUserId String    @unique @map("auth_user_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orgMembers OrgMember[]
  idlsUploaded Idl[] @relation("IdlUploader")
  savedSearches SavedSearch[]
  alertRules AlertRule[] @relation("AlertRuleCreator")
  alertIncidentsAcked AlertIncident[] @relation("AlertIncidentAcker")
  alertSilencesCreated AlertSilence[] @relation("AlertSilenceCreator")
  oncallShifts OncallShift[]
  errorComments ErrorComment[]

  @@unique([email])
  @@map("users")
}

model Org {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String      @unique
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  projects  Project[]
  members   OrgMember[]
  apiKeys   ApiKey[]
  auditLogs AuditLog[]
  ghInstallations GhInstallation[]
  tags Tag[]
  notificationChannels NotificationChannel[]
  notificationRoutes NotificationRoute[]
  oncallSchedules OncallSchedule[]
  escalationPolicies EscalationPolicy[]

  @@map("orgs")
}

model OrgMember {
  orgId  String          @map("org_id") @db.Uuid
  userId String          @map("user_id") @db.Uuid
  role   OrgMemberRole

  org  Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user SolobserveUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
  @@map("org_members")
}

model Project {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String      @map("org_id") @db.Uuid
  name      String
  slug      String
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  org      Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  programs SolanaProgram[]

  @@unique([orgId, slug])
  @@map("projects")
}

model SolanaProgram {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  programId   String           @map("program_id")
  cluster     SolanaCluster
  displayName String           @map("display_name")
  status      ProgramStatus    @default(active)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  idls    Idl[]
  ingestionConfig IngestionConfig?
  ingestionStates IngestionState[]
  ingestionErrors IngestionError[]
  trackedAccounts TrackedAccount[]
  dashboards Dashboard[]
  errorIssues ErrorIssue[]
  fieldWatches PendingFieldWatch[]
  errorNotifications ErrorNotification[]
  savedSearches SavedSearch[]
  alertRules AlertRule[]
  alertSilences AlertSilence[]
  replayScenarios ReplayScenario[]
  replayResults ReplayResult[]
  sdkSchemas SdkSchema[]
  cuThresholds Json @default("{}") @map("cu_thresholds") @db.JsonB
  cuBaselines CuBaseline[]
  cuRuns CuRun[]
  ghRepos GhRepo[]
  mevDetectionEnabled Boolean @default(false) @map("mev_detection_enabled")
  watchlists Watchlist[]
  mevFindings MevFinding[]
  anomalies Anomaly[]

  @@unique([projectId, programId, cluster])
  @@index([projectId])
  @@map("programs")
}

model GhInstallation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgIdFk        String   @map("org_id_fk") @db.Uuid
  installationId BigInt   @map("installation_id")
  accountLogin   String   @map("account_login")
  accountType    String   @map("account_type")
  repoIds        BigInt[] @map("repo_ids")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org Org @relation(fields: [orgIdFk], references: [id], onDelete: Cascade)
  repos GhRepo[]

  @@unique([installationId])
  @@index([orgIdFk])
  @@map("gh_installations")
}

model GhRepo {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  installationIdFk  String   @map("installation_id_fk") @db.Uuid
  repoFullName      String   @map("repo_full_name")
  defaultBranch     String   @default("main") @map("default_branch")
  linkedProgramIds  String[] @map("linked_program_ids") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  installation GhInstallation @relation(fields: [installationIdFk], references: [id], onDelete: Cascade)
  cuRuns CuRun[]
  cuBaselines CuBaseline[]
  programs SolanaProgram[]

  @@unique([installationIdFk, repoFullName])
  @@map("gh_repos")
}

enum CuRunStatus {
  pending
  success
  failed
  skipped
}

model CuRun {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk     String      @map("program_id_fk") @db.Uuid
  repoIdFk        String?     @map("repo_id_fk") @db.Uuid
  commitSha       String      @map("commit_sha")
  branch          String
  prNumber        Int?        @map("pr_number")
  status          CuRunStatus @default(pending)
  startedAt       DateTime    @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?   @map("finished_at") @db.Timestamptz(6)
  rawMetrics      Json        @default("{}") @map("raw_metrics") @db.JsonB
  bypassApplied   Boolean     @default(false) @map("bypass_applied")

  program SolanaProgram @relation(fields: [programIdFk], references: [id], onDelete: Cascade)
  repo    GhRepo?       @relation(fields: [repoIdFk], references: [id], onDelete: SetNull)

  @@index([programIdFk, commitSha])
  @@index([programIdFk, branch])
  @@map("cu_runs")
}

model CuBaseline {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk      String   @map("program_id_fk") @db.Uuid
  repoIdFk         String?  @map("repo_id_fk") @db.Uuid
  branch           String
  commitSha        String   @map("commit_sha")
  instructionName  String   @map("instruction_name")
  cuP50            Int      @map("cu_p50")
  cuP95            Int      @map("cu_p95")
  runId            String?  @map("run_id") @db.Uuid
  capturedAt       DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  program SolanaProgram @relation(fields: [programIdFk], references: [id], onDelete: Cascade)
  repo    GhRepo?       @relation(fields: [repoIdFk], references: [id], onDelete: SetNull)

  @@unique([programIdFk, branch, commitSha, instructionName])
  @@index([programIdFk, branch])
  @@map("cu_baselines")
}

model SdkSchema {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk String   @map("program_id_fk") @db.Uuid
  name        String
  version     Int      @default(1)
  schemaJson  Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  program SolanaProgram @relation(fields: [programIdFk], references: [id], onDelete: Cascade)

  @@unique([programIdFk, name, version])
  @@index([programIdFk])
  @@map("sdk_schemas")
}

model ReplayScenario {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk   String   @map("program_id_fk") @db.Uuid
  name          String
  baseSignature String   @map("base_signature")
  modifications Json     @db.JsonB
  shareWithTeam Boolean  @default(false) @map("share_with_team")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  program SolanaProgram @relation(fields: [programIdFk], references: [id], onDelete: Cascade)
  results ReplayResult[]

  @@index([programIdFk, updatedAt(sort: Desc)])
  @@map("replay_scenarios")
}

model ReplayResult {
  id                         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk                String          @map("program_id_fk") @db.Uuid
  scenarioIdFk               String?         @map("scenario_id_fk") @db.Uuid
  signature                  String
  modificationsHash          String          @map("modifications_hash")
  status                     ReplayRunStatus @default(queued)
  cuConsumed                 BigInt?         @map("cu_consumed")
  logs                       Json            @db.JsonB
  accountDiffs               Json            @map("account_diffs") @db.JsonB
  decodedResult              Json?           @map("decoded_result") @db.JsonB
  historicalStateUnavailable Boolean         @default(false) @map("historical_state_unavailable")
  executedAt                 DateTime?       @map("executed_at") @db.Timestamptz(6)
  executedBy                 String?         @map("executed_by") @db.Uuid
  createdAt                  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  program  SolanaProgram  @relation(fields: [programIdFk], references: [id], onDelete: Cascade)
  scenario ReplayScenario? @relation(fields: [scenarioIdFk], references: [id], onDelete: SetNull)

  @@index([programIdFk, createdAt(sort: Desc)])
  @@index([scenarioIdFk])
  @@map("replay_results")
}

model Dashboard {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk      String   @map("program_id_fk") @db.Uuid
  name             String
  slug             String
  ownerUserId      String?  @map("owner_user_id") @db.Uuid
  isTemplateSeeded Boolean  @default(false) @map("is_template_seeded")
  shareToken       String?  @unique @map("share_token")
  shareRedactSigners Boolean @default(true) @map("share_redact_signers")
  sharePasswordHash String?  @map("share_password_hash")
  shareExpiresAt    DateTime? @map("share_expires_at") @db.Timestamptz(6)
  shareRefererAllowlist String[] @default([]) @map("share_referer_allowlist")
  shareViewCount    Int      @default(0) @map("share_view_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  program SolanaProgram  @relation(fields: [programIdFk], references: [id], onDelete: Cascade)
  panels  DashboardPanel[]

  @@unique([programIdFk, slug])
  @@map("dashboards")
}

model DashboardPanel {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboardIdFk String   @map("dashboard_id_fk") @db.Uuid
  position      Json     @db.JsonB
  title         String
  panelType     String   @map("panel_type")
  queryDsl      String   @map("query_dsl")
  options       Json     @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  dashboard Dashboard @relation(fields: [dashboardIdFk], references: [id], onDelete: Cascade)

  @@map("dashboard_panels")
}

model DashboardTemplate {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String                @unique
  kind       DashboardTemplateKind
  definition Json                  @db.JsonB
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("dashboard_templates")
}

model ErrorIssue {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk       String              @map("program_id_fk") @db.Uuid
  fingerprint       String
  instructionName   String?             @map("instruction_name")
  errorCode         Int?                @map("error_code")
  errorName         String?             @map("error_name")
  classification    ErrorClassification @default(unknown)
  topConstraintKind String?             @map("top_constraint_kind")
  firstSeenAt       DateTime            @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt        DateTime            @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  totalCount        BigInt              @default(0) @map("total_count")
  status            ErrorIssueStatus    @default(open)
  mutedUntil        DateTime?           @map("muted_until") @db.Timestamptz(6)
  assigneeUserId    String?             @map("assignee_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  program       SolanaProgram       @relation(fields: [programIdFk], references: [id], onDelete: Cascade)
  samples       ErrorSample[]
  comments      ErrorComment[]
  notifications ErrorNotification[]

  @@unique([programIdFk, fingerprint])
  @@map("error_issues")
}

model ErrorSample {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueIdFk          String    @map("issue_id_fk") @db.Uuid
  signature          String
  slot               BigInt
  blockTime          DateTime? @map("block_time") @db.Timestamptz(6)
  signer             String?
  decodedArgs        Json      @map("decoded_args") @db.JsonB
  decodedAccounts    Json      @map("decoded_accounts") @db.JsonB
  logLines           String[]  @map("log_lines")
  constraintKind     String?   @map("constraint_kind")
  constraintExpected String?   @map("constraint_expected")
  constraintGot      String?   @map("constraint_got")
  cuConsumed         BigInt?   @map("cu_consumed")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  issue ErrorIssue @relation(fields: [issueIdFk], references: [id], onDelete: Cascade)

  @@map("error_samples")
}

model ErrorComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueIdFk String   @map("issue_id_fk") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  issue ErrorIssue @relation(fields: [issueIdFk], references: [id], onDelete: Cascade)
  user  SolobserveUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("error_comments")
}

model PendingFieldWatch {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk      String   @map("program_id_fk") @db.Uuid
  account          String
  fieldPath        String   @map("field_path")
  op               String
  thresholdNumeric Float?   @map("threshold_numeric")
  createdByUserId  String?  @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  program SolanaProgram @relation(fields: [programIdFk], references: [id], onDelete: Cascade)

  @@map("pending_field_watches")
}

model ErrorNotification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk String    @map("program_id_fk") @db.Uuid
  issueIdFk   String?   @map("issue_id_fk") @db.Uuid
  kind        String
  payload     Json      @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  program SolanaProgram @relation(fields: [programIdFk], references: [id], onDelete: Cascade)
  issue   ErrorIssue?   @relation(fields: [issueIdFk], references: [id], onDelete: Cascade)

  @@map("error_notifications")
}

model SavedSearch {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  programIdFk String   @map("program_id_fk") @db.Uuid
  name        String
  queryJson   Json     @map("query_json") @db.JsonB
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    SolobserveUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  program SolanaProgram  @relation(fields: [programIdFk], references: [id], onDelete: Cascade)

  @@map("saved_searches")
}

model AlertRule {
  id                        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programIdFk               String        @map("program_id_fk") @db.Uuid
  name                      String
  kind                      AlertRuleKind
  definition                Json          @db.JsonB
  evaluationIntervalSeconds Int           @map("evaluation_interval_seconds")
  severity                  AlertSeverity
  groupBy                   String[]      @map("group_by")
  enabled                   Boolean       @default(true)
  createdBy                 String?       @map("created_by") @db.Uuid
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  program   SolanaProgram    @relation(fields: [programIdFk], references: [id], onDelete: Cascade)
  creator   SolobserveUser?  @relation("AlertRuleCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  state     AlertRuleState?
  incidents AlertIncident[]

  @@map("alert_rules")
}

model AlertRuleState {
  ruleId      String           @id @map("rule_id") @db.Uuid
  lastEvalAt  DateTime?        @map("last_eval_at") @db.Timestamptz(6)
  lastValue   Json?            @map("last_value") @db.JsonB
  lastStatus  AlertStateStatus @default(ok) @map("last_status")
  sinceTs     DateTime?        @map("since_ts") @db.Timestamptz(6)

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("alert_rule_state")
}

model AlertIncident {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleIdFk   String              @map("rule_id_fk") @db.Uuid
  fingerprint String
  status     AlertIncidentStatus @default(firing)
  severity   AlertSeverity
  startedAt  DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  ackedAt    DateTime?           @map("acked_at") @db.Timestamptz(6)
  resolvedAt DateTime?           @map("resolved_at") @db.Timestamptz(6)
  ackUserId  String?             @map("ack_user_id") @db.Uuid
  summary    String
  dedupKey   String              @map("dedup_key")

  rule      AlertRule       @relation(fields: [ruleIdFk], references: [id], onDelete: Cascade)
  ackUser   SolobserveUser? @relation("AlertIncidentAcker", fields: [ackUserId], references: [id], onDelete: SetNull)
  events    AlertIncidentEvent[]
  deliveries AlertNotificationDelivery[]

  @@unique([ruleIdFk, dedupKey])
  @@map("alert_incidents")
}

model AlertNotificationDelivery {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentIdFk   String              @map("incident_id_fk") @db.Uuid
  routeIdFk      String?             @map("route_id_fk") @db.Uuid
  channelIdFk    String?             @map("channel_id_fk") @db.Uuid
  idempotencyKey String              @unique @map("idempotency_key")
  status         AlertDeliveryStatus @default(pending)
  attempts       Int                 @default(0)
  lastError      String?             @map("last_error")
  nextAttemptAt  DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  incident AlertIncident @relation(fields: [incidentIdFk], references: [id], onDelete: Cascade)
  route    NotificationRoute? @relation(fields: [routeIdFk], references: [id], onDelete: SetNull)
  channel  NotificationChannel? @relation(fields: [channelIdFk], references: [id], onDelete: SetNull)

  @@map("alert_notification_deliveries")
}

model AlertIncidentEvent {
