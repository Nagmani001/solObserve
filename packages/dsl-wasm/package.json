{
  "name": "@repo/dsl-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./wrapper.d.ts",
      "default": "./wrapper.js"
    }
  },
  "types": "./wrapper.d.ts",
  "scripts": {
    "build": "node -e \"require('fs').accessSync(require('path').join('pkg','solobserve_dsl.js'))\"",
    "rebuild:wasm": "cargo build --manifest-path ../../crates/solobserve-dsl/Cargo.toml --release --target wasm32-unknown-unknown --features wasm && wasm-bindgen ../../target/wasm32-unknown-unknown/release/solobserve_dsl.wasm --nodejs --typescript --out-dir ./pkg"
  },
  "files": ["pkg", "wrapper.js", "wrapper.d.ts"]
}
