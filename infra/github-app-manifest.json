{
  "name": "SolObserve CU Regression",
  "description": "Pre-merge CU regression guard for Solana programs.",
  "url": "https://solobserve.dev",
  "hook_attributes": {
    "url": "https://api.solobserve.dev/v1/integrations/github/webhook"
  },
  "redirect_url": "https://app.solobserve.dev/integrations/github/callback",
  "callback_urls": ["https://app.solobserve.dev/integrations/github/callback"],
  "public": false,
  "default_events": ["pull_request", "push", "installation", "installation_repositories"],
  "default_permissions": {
    "metadata": "read",
    "contents": "read",
    "checks": "write",
    "pull_requests": "write"
  }
}
