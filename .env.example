# SolObserve env (copy to .env.local; never commit secrets)

# --- Postgres (app + state) ---
POSTGRES_URL=postgresql://solobserve:solobserve@localhost:5432/solobserve

# --- ClickHouse ---
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=solobserve

# --- NATS JetStream ---
NATS_URL=nats://localhost:4222

# --- S3-compat (MinIO local) ---
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=solobserve-raw
S3_FORCE_PATH_STYLE=true

# --- Solana RPC (FREE only — no paid required) ---
# Comma-separated. Failover order = list order.
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_WS=wss://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC=https://api.devnet.solana.com
SOLANA_DEVNET_WS=wss://api.devnet.solana.com

# --- Auth.js ---
AUTH_SECRET=change-me-32-bytes
AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- API gateway ---
API_GATEWAY_URL=http://localhost:8080
API_GATEWAY_BIND=0.0.0.0:8080

# --- MCP server credentials (optional — only set if you want the MCP server live) ---
GITHUB_PERSONAL_ACCESS_TOKEN=
POSTGRES_MCP_URL=postgresql://solobserve:solobserve@localhost:5432/solobserve

# --- Anthropic (optional — only for NL → DSL feature, plan 5) ---
ANTHROPIC_API_KEY=
